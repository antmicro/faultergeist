set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
openroad="${OPENROAD:-openroad}"
csv_file=""
odb_file=""

function usage {
  cat <<EOF
Usage: $(basename "$0") -o CSV [--openroad PATH] DESIGN.odb

  -o CSV            output CSV
  --openroad PATH   openroad binary (default: \$OPENROAD, else from PATH)
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -o | --output)
    csv_file="$2"
    shift 2
    ;;
  --openroad)
    openroad="$2"
    shift 2
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  -*)
    echo "Unknown option: $1" >&2
    usage >&2
    exit 2
    ;;
  *)
    if [[ -n "$odb_file" ]]; then
      echo "Unexpected argument: $1" >&2
      exit 2
    fi
    odb_file="$1"
    shift
    ;;
  esac
done

if [[ -z "$odb_file" ]]; then
  usage >&2
  exit 2
fi
if [[ ! -f "$odb_file" ]]; then
  echo "No such file: $odb_file" >&2
  exit 1
fi
if [[ -z "$csv_file" ]]; then
  usage >&2
  exit 2
fi
if ! command -v "$openroad" >/dev/null 2>&1; then
  echo "OpenROAD not found: $openroad" >&2
  exit 1
fi

exec "$openroad" -python -no_splash -exit \
  "$script_dir/export_placement_cmd.py" "$script_dir" "$odb_file" "$csv_file"
